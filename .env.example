# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Optional: enables Published Reviews poster matching against the public Posters Google Drive folder.
VITE_GOOGLE_DRIVE_API_KEY=

# Only when hosting under a sub-path (GitHub Pages project site): VITE_BASE=/your-repo-name/
# VITE_BASE=/

# Optional (recommended for personalised ads): serve /ad-frame.html from a SEPARATE origin, e.g. https://ads.your-domain.com
# so third-party ad code can never touch the app's storage or login session. Leave empty to keep ads fully sandboxed.
VITE_AD_FRAME_ORIGIN=
