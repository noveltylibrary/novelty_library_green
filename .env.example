# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Google OAuth Client ID (Web). Makes Google sign-in show your own site instead of *.supabase.co. Leave empty to use the Supabase redirect flow.
VITE_GOOGLE_CLIENT_ID=

# Optional: enables Published Reviews poster matching against the public Posters Google Drive folder.
VITE_GOOGLE_DRIVE_API_KEY=

# Only when hosting under a sub-path (GitHub Pages project site): VITE_BASE=/your-repo-name/
# VITE_BASE=/

# Google AdSense (Vercel → Settings → Environment Variables, then redeploy).
# VITE_ADSENSE_CLIENT: your publisher ID, e.g. ca-pub-1234567890123456
# VITE_ADSENSE_SLOT:   a Display ad unit ID (AdSense → Ads → By ad unit → Display ads → create → copy data-ad-slot)
# Leave both empty to show no ads. Also put your publisher ID in public/ads.txt.
# (client defaults to ca-pub-4287486804733527; only set this to override)
VITE_ADSENSE_CLIENT=
# (slot defaults to the "Novelty Library WebApp" unit, 7417970298; only set this to override)
VITE_ADSENSE_SLOT=

# Cloudflare Turnstile (CAPTCHA) site key — PUBLIC key only. Vercel → Environment Variables, then redeploy.
# Leave empty to disable. Order matters: set this and redeploy FIRST, then enable CAPTCHA in
# Supabase → Authentication → Attack Protection (Turnstile + secret key). Turning it off in Supabase restores old behaviour.
VITE_TURNSTILE_SITE_KEY=
