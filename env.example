# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# EthicalAds
VITE_ETHICALADS_PUBLISHER_ID=YOUR-PUBLISHER-ID
PUBLIC_ETHICALADS_PUBLISHER_ID=YOUR-PUBLISHER-ID

# Optional: enables Published Reviews poster matching against the public Posters Google Drive folder.
VITE_GOOGLE_DRIVE_API_KEY=

# Only when hosting under a sub-path (GitHub Pages project site): VITE_BASE=/your-repo-name/
# VITE_BASE=/
